# GENESYS-SDK-BEGIN
# The following section is managed by the Genesys SDK.
# It will be updated when you update the SDK.
# Add your custom ignore patterns AFTER this section (below GENESYS-SDK-END).

**/.dist/**
**/node_modules/**
**/.engine/**
**/**dist/**
**/**editor/**
**/.editor/**
**/.DS_Store
**/*.tgz
**/*.mcp-port
.cursor/mcp.json
**/.placeholder
# Regenerated on every project create/update/open (see skills-sync.ts); never commit the link itself.
.claude/skills
# Ignore all of .genesys except the sdk/ folder (SDK base files)
**/.genesys/*
!.genesys/sdk/
!.genesys/sdk/**
**/logs/**
**/.turbo/**
**/.cache/**
**/.intermediate/*
# Agent work files and raw art downloads (Blender and generated-asset skills); never committed or shipped
/.scratch/
/art-source/

# GENESYS-SDK-END

# ============================================
# Add your custom gitignore patterns below
# These will be preserved during SDK updates
# ============================================


# ------------------------------------------------------------------
# The exported playable build lives in dist-standalone/. The SDK rules
# above ignore every .dist/ and node_modules/, so it has to be
# re-included here (later rules win).
# ------------------------------------------------------------------
!dist-standalone/
!dist-standalone/**
!dist-standalone/.dist/
!dist-standalone/.dist/**
!dist-standalone/node_modules/
!dist-standalone/node_modules/**

# Sourcemaps in the shipped build are not needed and cost ~28 MB.
dist-standalone/**/*.map
